# Noms des variables uniquement : les valeurs se mettent dans .env.local (jamais
# commité) et dans Vercel (Production, Preview, Development).

# ─────────────────────────────────────────────────
# Supabase — tableau de bord → Settings → API Keys
# ─────────────────────────────────────────────────

# Adresse du projet (publique)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique « publishable », lue par le navigateur et le serveur
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ancienne clé publique « anon » : repli tant que la bascule n'est pas finie,
# à supprimer ensuite
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète, SERVEUR UNIQUEMENT : jamais de préfixe NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Ancienne clé « service_role » : repli tant que la bascule n'est pas finie,
# à supprimer ensuite
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────

# Adresse du site (http://localhost:3000 en local)
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────
# Resend (emails), serveur uniquement
# ─────────────────────────────────────────────────

RESEND_API_KEY=
